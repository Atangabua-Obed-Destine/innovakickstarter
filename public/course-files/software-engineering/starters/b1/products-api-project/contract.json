{
  "checks": [
    {"name": "List products", "method": "GET", "path": "/api/products", "body": null,
     "expect": {"status": 200, "has": ["data.0.id", "data.0.sku", "data.0.name", "data.0.category", "data.0.unit", "data.0.price_fcfa", "meta.count"], "equals": {"data.0.currency": "FCFA"}, "min_count": {"data": 20}}},
    {"name": "Filter by category", "method": "GET", "path": "/api/products?category=Grains", "body": null,
     "expect": {"status": 200, "equals": {"data.0.category": "Grains", "data.3.category": "Grains"}, "min_count": {"data": 4}}},
    {"name": "Search by name (any letter case)", "method": "GET", "path": "/api/products?search=rice", "body": null,
     "expect": {"status": 200, "equals": {"data.0.name": "Rice 25kg", "data.1.name": "Rice 50kg"}, "min_count": {"data": 2}}},
    {"name": "Show one product", "method": "GET", "path": "/api/products/6", "body": null,
     "expect": {"status": 200, "equals": {"data.id": 6, "data.name": "Rice 50kg", "data.price_fcfa": 36005, "data.currency": "FCFA"}}},
    {"name": "Missing product is 404", "method": "GET", "path": "/api/products/999999", "body": null,
     "expect": {"status": 404, "has": ["message"]}},
    {"name": "Branches", "method": "GET", "path": "/api/branches", "body": null,
     "expect": {"status": 200, "has": ["data.0.name", "data.0.city", "data.0.manager", "data.0.opened_year"], "equals": {"data.0.code": "NKW", "data.0.status": "open", "data.4.code": "LMB", "data.4.status": "planned"}, "min_count": {"data": 5}}},
    {"name": "Create with bad data is 422", "method": "POST", "path": "/api/products",
     "body": {"sku": "", "name": "", "category": "Electronics", "unit": "bag", "price_fcfa": -5},
     "expect": {"status": 422, "has": ["message", "errors.sku", "errors.name", "errors.category", "errors.price_fcfa"]}},
    {"name": "Create a product", "method": "POST", "path": "/api/products",
     "body": {"sku": "TEST-{{rand}}", "name": "Garri 1kg", "category": "Groceries", "unit": "bag", "price_fcfa": 650},
     "expect": {"status": 201, "has": ["data.id"], "equals": {"data.name": "Garri 1kg", "data.category": "Groceries", "data.price_fcfa": 650, "data.currency": "FCFA"}},
     "save": {"productId": "data.id"}},
    {"name": "Duplicate SKU is 422", "method": "POST", "path": "/api/products",
     "body": {"sku": "TEST-{{rand}}", "name": "Garri 1kg", "category": "Groceries", "unit": "bag", "price_fcfa": 650},
     "expect": {"status": 422, "has": ["errors.sku"]}},
    {"name": "Read the new product", "method": "GET", "path": "/api/products/{{productId}}", "body": null,
     "expect": {"status": 200, "equals": {"data.name": "Garri 1kg", "data.price_fcfa": 650}}},
    {"name": "Update the price", "method": "PATCH", "path": "/api/products/{{productId}}", "body": {"price_fcfa": 700},
     "expect": {"status": 200, "equals": {"data.price_fcfa": 700, "data.name": "Garri 1kg", "data.category": "Groceries"}}},
    {"name": "Update with a bad price is 422", "method": "PATCH", "path": "/api/products/{{productId}}", "body": {"price_fcfa": 0},
     "expect": {"status": 422, "has": ["errors.price_fcfa"]}},
    {"name": "Delete the product", "method": "DELETE", "path": "/api/products/{{productId}}", "body": null,
     "expect": {"status": 204}},
    {"name": "Deleted product is gone", "method": "GET", "path": "/api/products/{{productId}}", "body": null,
     "expect": {"status": 404, "has": ["message"]}}
  ]
}
