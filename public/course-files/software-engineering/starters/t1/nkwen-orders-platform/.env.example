# Settings for "docker compose up". Copy this file to .env (next to docker-compose.yml).
# .env is in .gitignore: never commit it, and never put real passwords in this example file.
#
# APP_KEY is Laravel's secret key. Make one with Node (works on any computer):
#   node -e "console.log('base64:' + require('crypto').randomBytes(32).toString('base64'))"
# or, inside api/ with PHP installed:  php artisan key:generate --show
APP_KEY=

# Passwords for the local MySQL container only. Change them if you like.
DB_PASSWORD=local-dev-only
DB_ROOT_PASSWORD=local-dev-root
