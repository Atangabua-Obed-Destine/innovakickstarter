{"checks": [
  {"name": "Stock list for Nkwen", "method": "GET", "path": "/api/branches/NKW/stock", "body": null,
   "expect": {"status": 200, "has": ["data.0.product_id", "data.0.quantity", "data.0.status", "meta.count"], "equals": {"data.0.branch_code": "NKW"}, "min_count": {"data": 20}}},
  {"name": "Unknown branch is 404", "method": "GET", "path": "/api/branches/XYZ/stock", "body": null,
   "expect": {"status": 404, "has": ["message"]}},
  {"name": "Restock 2 bags of Rice 50kg at Commercial Avenue", "method": "POST", "path": "/api/stock/restock",
   "body": {"branch": "CAV", "product_id": 6, "quantity": 2, "note": "Contract check delivery"},
   "expect": {"status": 201, "has": ["data.id", "data.balance_after"], "equals": {"data.reason": "restock", "data.change": 2, "data.product_id": 6}}},
  {"name": "Restock 1 Palm Oil 5L at Commercial Avenue", "method": "POST", "path": "/api/stock/restock",
   "body": {"branch": "CAV", "product_id": 15, "quantity": 1, "note": "Contract check delivery"},
   "expect": {"status": 201, "equals": {"data.reason": "restock", "data.change": 1}}},
  {"name": "Create an order with two items", "method": "POST", "path": "/api/orders",
   "headers": {"Idempotency-Key": "contract-{{rand}}"},
   "body": {"branch": "CAV", "customer_name": "Mbah Clarisse", "payment_method": "mtn_momo", "items": [{"product_id": 6, "quantity": 2}, {"product_id": 15, "quantity": 1}]},
   "save": {"orderId": "data.id"},
   "expect": {"status": 201, "has": ["data.id", "data.created_at", "data.items.1.line_total_fcfa"], "equals": {"data.branch": "CAV", "data.status": "awaiting_payment", "data.total_fcfa": 78610, "data.currency": "FCFA", "data.items.0.unit_price_fcfa": 36005, "data.items.0.line_total_fcfa": 72010}}},
  {"name": "Same Idempotency-Key again: no second sale", "method": "POST", "path": "/api/orders",
   "headers": {"Idempotency-Key": "contract-{{rand}}"},
   "body": {"branch": "CAV", "customer_name": "Mbah Clarisse", "payment_method": "mtn_momo", "items": [{"product_id": 6, "quantity": 2}, {"product_id": 15, "quantity": 1}]},
   "expect": {"status": [200, 201], "equals": {"data.total_fcfa": 78610, "data.status": "awaiting_payment"}}},
  {"name": "Read the order back", "method": "GET", "path": "/api/orders/{{orderId}}", "body": null,
   "expect": {"status": 200, "equals": {"data.branch": "CAV", "data.total_fcfa": 78610, "data.items.0.product_id": 6, "data.items.0.quantity": 2}, "min_count": {"data.items": 2}}},
  {"name": "Not enough bread at Mile 4 is 409", "method": "POST", "path": "/api/orders",
   "body": {"branch": "ML4", "customer_name": "Contract Check", "payment_method": "cash", "items": [{"product_id": 1, "quantity": 100}]},
   "expect": {"status": 409, "has": ["message", "available"], "equals": {"product_id": 1, "requested": 100}}},
  {"name": "Second item short: whole order refused (409)", "method": "POST", "path": "/api/orders",
   "body": {"branch": "CAV", "customer_name": "Contract Check", "payment_method": "cash", "items": [{"product_id": 6, "quantity": 1}, {"product_id": 19, "quantity": 500}]},
   "expect": {"status": 409, "equals": {"product_id": 19, "requested": 500}}},
  {"name": "History: one sale of 2 bags, right after the delivery", "method": "GET", "path": "/api/stock-movements?branch=CAV&product_id=6", "body": null,
   "expect": {"status": 200, "has": ["data.0.balance_after", "data.0.order_id", "meta.count"], "equals": {"data.0.reason": "sale", "data.0.change": -2, "data.1.reason": "restock", "data.1.change": 2}}},
  {"name": "Planned branch (Limbe) is 422", "method": "POST", "path": "/api/orders",
   "body": {"branch": "LMB", "customer_name": "Contract Check", "payment_method": "cash", "items": [{"product_id": 12, "quantity": 1}]},
   "expect": {"status": 422, "has": ["message", "errors.branch"]}},
  {"name": "Cancel the order (stock goes back)", "method": "PATCH", "path": "/api/orders/{{orderId}}",
   "body": {"status": "cancelled"},
   "expect": {"status": 200, "equals": {"data.status": "cancelled"}}},
  {"name": "A cancelled order cannot be delivered (409)", "method": "PATCH", "path": "/api/orders/{{orderId}}",
   "body": {"status": "delivered"},
   "expect": {"status": 409, "has": ["message"]}},
  {"name": "Unknown order is 404", "method": "GET", "path": "/api/orders/ORD-NOTFOUND", "body": null,
   "expect": {"status": 404, "has": ["message"]}},
  {"name": "List Commercial Avenue orders", "method": "GET", "path": "/api/orders?branch=CAV", "body": null,
   "expect": {"status": 200, "has": ["data.0.id", "data.0.total_fcfa", "data.0.items", "meta.count"], "equals": {"data.0.branch": "CAV"}}}
]}
