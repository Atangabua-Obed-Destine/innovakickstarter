{
  "checks": [
    {"name": "List products", "method": "GET", "path": "/api/products", "body": null,
     "expect": {"status": 200, "has": ["data.0.id", "data.0.name", "data.0.price_fcfa", "meta.count"], "equals": {"data.0.currency": "FCFA"}, "min_count": {"data": 20}}},
    {"name": "Stock at Commercial Avenue", "method": "GET", "path": "/api/branches/CAV/stock", "body": null,
     "expect": {"status": 200, "has": ["data.0.product_id", "data.0.sku", "data.0.name", "data.0.quantity", "data.0.reorder_level", "data.0.status", "meta.count"], "equals": {"data.0.branch_code": "CAV"}, "min_count": {"data": 20}}},
    {"name": "Orders without a token is 401", "method": "GET", "path": "/api/orders", "body": null,
     "expect": {"status": 401, "has": ["message"]}},
    {"name": "A new cashier signs up at Commercial Avenue (cannot choose a role)", "method": "POST", "path": "/api/register",
     "body": {"name": "Contract Cashier", "email": "cashier+{{rand}}@nkwen.test", "password": "Till-Pass-2026", "password_confirmation": "Till-Pass-2026", "branch": "CAV", "role": "head_office"},
     "expect": {"status": 201, "has": ["data.id", "data.email"], "equals": {"data.role": "cashier", "data.branch": "CAV"}}},
    {"name": "A wrong password is refused", "method": "POST", "path": "/api/login",
     "body": {"email": "cashier+{{rand}}@nkwen.test", "password": "Wrong-Pass-2026"},
     "expect": {"status": [401, 422], "has": ["message"]}},
    {"name": "The cashier logs in", "method": "POST", "path": "/api/login",
     "body": {"email": "cashier+{{rand}}@nkwen.test", "password": "Till-Pass-2026"},
     "save": {"token": "token"},
     "expect": {"status": 200, "has": ["token"], "equals": {"data.role": "cashier", "data.branch": "CAV"}}},
    {"name": "A bad order is 422", "method": "POST", "path": "/api/orders", "headers": {"Authorization": "Bearer {{token}}"},
     "body": {"branch": "CAV", "customer_name": "", "payment_method": "bitcoin", "items": []},
     "expect": {"status": 422, "has": ["message", "errors.customer_name", "errors.payment_method", "errors.items"]}},
    {"name": "Not enough stock is 409", "method": "POST", "path": "/api/orders", "headers": {"Authorization": "Bearer {{token}}"},
     "body": {"branch": "CAV", "customer_name": "Contract Check", "payment_method": "cash", "items": [{"product_id": 6, "quantity": 100000}]},
     "expect": {"status": 409, "has": ["message", "available"], "equals": {"product_id": 6, "requested": 100000}}},
    {"name": "The cashier cannot sell at another branch (403)", "method": "POST", "path": "/api/orders", "headers": {"Authorization": "Bearer {{token}}"},
     "body": {"branch": "ML4", "customer_name": "Contract Check", "payment_method": "cash", "items": [{"product_id": 12, "quantity": 1}]},
     "expect": {"status": 403, "has": ["message"]}},
    {"name": "Place an order (the server sets the prices)", "method": "POST", "path": "/api/orders", "headers": {"Authorization": "Bearer {{token}}", "Idempotency-Key": "fs3-{{rand}}"},
     "body": {"branch": "CAV", "customer_name": "Mbah Clarisse", "payment_method": "mtn_momo", "items": [{"product_id": 6, "quantity": 2}, {"product_id": 15, "quantity": 1}]},
     "save": {"orderId": "data.id"},
     "expect": {"status": 201, "has": ["data.id", "data.created_at"], "equals": {"data.branch": "CAV", "data.status": "awaiting_payment", "data.items.0.line_total_fcfa": 72010, "data.total_fcfa": 78610, "data.currency": "FCFA"}}},
    {"name": "Same Idempotency-Key again: no second sale", "method": "POST", "path": "/api/orders", "headers": {"Authorization": "Bearer {{token}}", "Idempotency-Key": "fs3-{{rand}}"},
     "body": {"branch": "CAV", "customer_name": "Mbah Clarisse", "payment_method": "mtn_momo", "items": [{"product_id": 6, "quantity": 2}, {"product_id": 15, "quantity": 1}]},
     "expect": {"status": [200, 201], "equals": {"data.total_fcfa": 78610, "data.status": "awaiting_payment"}}},
    {"name": "Read the order back", "method": "GET", "path": "/api/orders/{{orderId}}", "headers": {"Authorization": "Bearer {{token}}"}, "body": null,
     "expect": {"status": 200, "equals": {"data.branch": "CAV", "data.total_fcfa": 78610, "data.items.1.name": "Palm Oil 5L"}, "min_count": {"data.items": 2}}},
    {"name": "A cashier cannot cancel an order (403)", "method": "PATCH", "path": "/api/orders/{{orderId}}", "headers": {"Authorization": "Bearer {{token}}"}, "body": {"status": "cancelled"},
     "expect": {"status": 403, "has": ["message"]}},
    {"name": "The demo head office account logs in", "method": "POST", "path": "/api/login",
     "body": {"email": "headoffice@nkwen.test", "password": "Nkwen-Demo-2026"},
     "save": {"hoToken": "token"},
     "expect": {"status": 200, "has": ["token"], "equals": {"data.role": "head_office"}}},
    {"name": "Head office cancels the order (stock goes back)", "method": "PATCH", "path": "/api/orders/{{orderId}}", "headers": {"Authorization": "Bearer {{hoToken}}"}, "body": {"status": "cancelled"},
     "expect": {"status": 200, "equals": {"data.status": "cancelled", "data.branch": "CAV"}}}
  ]
}
